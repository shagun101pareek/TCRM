# Copy this file to .env in this folder and fill the values.
# Do not commit .env. The Lambda reads the same names from its environment.
# A local run also fills any blank key from the repository root .env.

# Mongo
MONGODB_URI=
MONGODB_DB=stance-dashboard

# TeleCRM. Search uses the Sync token. Temperature push uses the Async token.
# Root .env may name these TELECRM_SYNC_API2 and TELECRM_ASYNC_API2.
TELECRM_ENTERPRISE_ID=
TELECRM_API_TOKEN=
TELECRM_AUTOUPDATE_TOKEN=

# Accepted aliases if the names above are blank.
TELECRM_SYNC_API2=
TELECRM_ASYNC_API2=

# One invoke handles one page, then exits. Temperature calls TeleCRM per lead,
# so its page is smaller than the 15 minute Lambda limit.
NIGHTLY_TEMPERATURE_PAGE_SIZE=10
NIGHTLY_SOURCE_PAGE_SIZE=25
NIGHTLY_STATE_COLLECTION=nightly_worker_state
TELECRM_TIMEOUT_MS=20000

# true = read and score, do not write Mongo and do not POST temperature.
DRY_RUN=false
