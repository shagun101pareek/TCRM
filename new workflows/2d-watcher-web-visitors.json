{
  "name": "new-telecrm | 2d. Watcher: web_visitors collection",
  "nodes": [
    {
      "id": "w4-trigger",
      "name": "Watch web_visitors",
      "type": "n8n-nodes-base.mongoDbTrigger",
      "typeVersion": 1,
      "position": [240, 300],
      "parameters": {
        "databaseName": "stance-dashboard",
        "collectionName": "web_visitors",
        "fieldsToMonitor": "*",
        "operationTypes": ["insert", "update", "replace"]
      },
      "credentials": { "mongoDb": { "id": "REPLACE_WITH_MONGO_CRED_ID", "name": "MongoDB" } }
    },
    {
      "id": "w4-uid",
      "name": "Extract User ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300],
      "parameters": {
        "jsCode": "const ev = $input.first().json;\nif (!['insert','update','replace'].includes(ev.operationType)) return [];\nconst doc = ev.fullDocument;\nconst userId = doc && doc.patient_id;\nif (!userId) return [];\nreturn [{ json: { userId: String(userId) } }];"
      }
    },
    {
      "id": "w4-user",
      "name": "Find User by ID",
      "type": "n8n-nodes-base.mongoDb",
      "typeVersion": 1,
      "position": [680, 300],
      "parameters": {
        "operation": "findOne",
        "collection": "users",
        "query": "={{ JSON.stringify({ _id: { $oid: $('Extract User ID').first().json.userId } }) }}"
      },
      "credentials": { "mongoDb": { "id": "REPLACE_WITH_MONGO_CRED_ID", "name": "MongoDB" } },
      "onError": "continueRegularOutput"
    },
    {
      "id": "w4-phone",
      "name": "Extract Phone",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300],
      "parameters": {
        "jsCode": "const user = $('Find User by ID').first().json;\nif (!user || !user.phone) return [];\nfunction normPhone10(raw) {\n  let s = String(raw).trim().replace(/[^0-9]/g, '');\n  if (s.length === 11 && s.startsWith('0')) s = s.slice(1);\n  if (s.length === 12 && s.startsWith('91')) s = s.slice(2);\n  return s;\n}\nconst phone10 = normPhone10(user.phone);\nif (!phone10 || phone10.length < 10) return [];\nreturn [{ json: { phone: phone10 } }];"
      }
    },
    {
      "id": "w4-call",
      "name": "Call Sync Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1120, 300],
      "parameters": {
        "method": "POST",
        "url": "REPLACE_WITH_SYNC_WEBHOOK_URL",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ phone: $('Extract Phone').first().json.phone }) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Watch web_visitors": { "main": [[{ "node": "Extract User ID", "type": "main", "index": 0 }]] },
    "Extract User ID": { "main": [[{ "node": "Find User by ID", "type": "main", "index": 0 }]] },
    "Find User by ID": { "main": [[{ "node": "Extract Phone", "type": "main", "index": 0 }]] },
    "Extract Phone": { "main": [[{ "node": "Call Sync Webhook", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
